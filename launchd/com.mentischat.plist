<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Regenerate this file for another checkout with `launchd/install.sh`; the
  absolute path below is the one per-machine value launchd cannot expand
  itself.

  KeepAlive restarts the daemon after any non-zero exit (a panic, a server
  error) or a crash, but not after a clean exit, so a deliberate `make stop`
  (SIGTERM, exit 0) stays stopped. While another instance owns the port the
  daemon exits 1, and launchd retries every ThrottleInterval (30 s) until the
  port is free.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mentischat</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/austinfaulkner-pearce/workspace/mentischat/launchd/run.sh</string>
    </array>
</dict>
</plist>
